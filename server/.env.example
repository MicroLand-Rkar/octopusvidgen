# Copy to server/.env
PORT=8787
# 1 = make a 5-second ffmpeg test video instead of calling Claude (no tokens spent)
OVG_DRY_RUN=1
OVG_MAX_CONCURRENT_JOBS=1
CLAUDE_BIN=claude
CLAUDE_EFFORT=high
# CLAUDE_MODEL=claude-opus-5-5
# OVG_DATA_DIR=../data

# Jobs call the `claude` CLI as the user running the server. Either sign that CLI in (`claude`, then /login),
# or give the server its own key:
# ANTHROPIC_API_KEY=

# Styles that draw with an image generator (Manga Panels, Comic History, Text Flash Cuts):
#   none        = such films stop with a clear message (default)
#   chrome-flow = make the images in Google Flow in this Mac's signed-in Chrome via Claude in Chrome
#                 (local single-user testing only: needs Chrome open with the Claude extension connected)
OVG_IMAGE_TOOL=none

